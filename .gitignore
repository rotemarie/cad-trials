# OS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# environments
venv/
venv-*/
.venv/
env/

# Claude Code local settings (never commit)
.claude/

# model weights / caches (never commit — pull from HF/ModelScope)
hf_cache/
*.safetensors
*.ckpt
*.pth
checkpoints/
weights/

# experiment outputs — none of this is committed. The run ledger and the report
# are generated from real cluster runs; an earlier synthetic runs.jsonl/report.html
# was committed by mistake and has been untracked (append_run appends, so a stale
# ledger would mix fabricated metrics into the first real run).
cad-trials/results/**/*.stl
cad-trials/results/**/*.step
cad-trials/results/**/*.ply
cad-trials/results/**/*.png
cad-trials/results/*.tsv
cad-trials/results/prepared/
cad-trials/results/runs.jsonl
cad-trials/results/runs.d/
cad-trials/results/report.html
cad-trials/work_dirs/
work_dirs/

# large local data (regenerated by data/ scripts)
cad-trials/data/benchmarks/
cad-trials/vendor/

# cluster cruft
slurm-*.out
*.sbatch.tmp
pycharm-server.sbatch
pycharm_session_*.log
